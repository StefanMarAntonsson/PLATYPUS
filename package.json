{
  "name": "platypus",
  "version": "0.0.11",
  "private": true,
  "description": "A local-first personal media tracker",
  "license": "MIT",
  "author": "Stefan Mar Antonsson",
  "repository": {
    "type": "git",
    "url": "https://github.com/StefanMarAntonsson/PLATYPUS.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/set-version.mjs --check",
    "prepare": "vp config && svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-updater": "~2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "ajv": "^8.20.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3"
  },
  "overrides": {
    "cookie": "0.7.2",
    "devalue": "5.9.4",
    "fast-uri": "3.1.8",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "ws": "8.21.3"
  },
  "packageManager": "bun@1.3.13"
}
